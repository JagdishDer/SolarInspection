# Copy this file to .env and adjust values as needed.
# Base URL of the real backend API (used when EXPO_PUBLIC_USE_MOCK_API=false).
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# When true, the app talks to the built-in mock API client (no real network needed).
# When false, the app uses EXPO_PUBLIC_API_URL for all requests.
EXPO_PUBLIC_USE_MOCK_API=true

# Simulated failure rate (0.0 - 1.0) of the mock API. 0.2 = ~20% of requests fail.
EXPO_PUBLIC_MOCK_FAILURE_RATE=0.2
